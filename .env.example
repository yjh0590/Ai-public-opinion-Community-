# Copy this file to .env. Without a key, the app runs in clearly labeled demo mode.
# Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# OpenAI (paid). Used only when GEMINI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173
